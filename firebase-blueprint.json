{
  "entities": {
    "settings": {
      "title": "SystemSettings",
      "description": "Government ITI Raigarh system configuration and campus rules",
      "type": "object",
      "properties": {
        "instituteName": { "type": "string" },
        "instituteCode": { "type": "string" },
        "affiliation": { "type": "string" },
        "department": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "minimumAttendancePercent": { "type": "number" },
        "currentSessionId": { "type": "string" }
      },
      "required": ["instituteName", "instituteCode"]
    },
    "session": {
      "title": "AcademicSession",
      "description": "Academic sessions and training batches",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalWorkingDays": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "upcoming", "completed"] }
      },
      "required": ["id", "name", "startDate", "endDate", "status"]
    },
    "trade": {
      "title": "Trade",
      "description": "Vocational trades offered at the institute",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "durationYears": { "type": "number" },
        "totalIntake": { "type": "number" },
        "workshopLocation": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "code", "status"]
    },
    "officer": {
      "title": "TrainingOfficer",
      "description": "Institutional training officers and staff accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "employeeId": { "type": "string" },
        "assignedTradeIds": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "email", "employeeId", "status"]
    },
    "trainee": {
      "title": "Trainee",
      "description": "Enrolled vocational trainee record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rollNo": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "tradeId": { "type": "string" },
        "sessionId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "completed"] }
      },
      "required": ["id", "rollNo", "name", "tradeId", "status"]
    },
    "attendance": {
      "title": "AttendanceRecord",
      "description": "Daily trainee attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "traineeId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "checkInTime": { "type": "string" },
        "verifiedBy": { "type": "string" }
      },
      "required": ["id", "traineeId", "date", "status"]
    },
    "assessment": {
      "title": "TraineeAssessment",
      "description": "Monthly formative assessment marks and practical performance evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "traineeId": { "type": "string" },
        "sessionId": { "type": "string" },
        "month": { "type": "string" },
        "testMarks": { "type": "number" },
        "attendancePercent": { "type": "number" },
        "remarks": { "type": "string" }
      },
      "required": ["id", "traineeId", "month", "testMarks"]
    },
    "leave": {
      "title": "LeaveRequest",
      "description": "Trainee leave request and approval sanction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "traineeId": { "type": "string" },
        "leaveType": { "type": "string" },
        "fromDate": { "type": "string" },
        "toDate": { "type": "string" },
        "days": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["id", "traineeId", "leaveType", "status"]
    },
    "warning": {
      "title": "WarningNotice",
      "description": "Official regulatory notice for attendance shortage or discipline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "traineeId": { "type": "string" },
        "refNumber": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "traineeId", "refNumber", "status"]
    },
    "workingDay": {
      "title": "MonthlyWorkingDay",
      "description": "Official institutional working days per month",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "month": { "type": "string" },
        "workingDays": { "type": "number" },
        "holidays": { "type": "number" }
      },
      "required": ["id", "sessionId", "month", "workingDays"]
    },
    "holiday": {
      "title": "HolidayRecord",
      "description": "Admin-designated holiday dates restricting attendance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "sessionId": { "type": "string" },
        "remarks": { "type": "string" }
      },
      "required": ["id", "date", "title", "category"]
    },
    "document": {
      "title": "StoredDocumentRecord",
      "description": "Persistent institutional file, circular, medical certificate, or photo metadata linked to Firebase Storage or Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "sizeBytes": { "type": "number" },
        "category": { "type": "string" },
        "storagePath": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "storageProvider": { "type": "string", "enum": ["firebase_storage", "firestore_storage"] },
        "uploadedById": { "type": "string" },
        "uploadedByRole": { "type": "string", "enum": ["admin", "officer", "trainee"] },
        "tradeId": { "type": "string" },
        "traineeId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "fileName", "downloadUrl", "storageProvider", "uploadedById", "uploadedByRole", "createdAt"]
    },
    "storedFile": {
      "title": "StoredFileChunk",
      "description": "Chunked file payload stored in Cloud Firestore when Cloud Storage bucket is uninitialized",
      "type": "object",
      "properties": {
        "docId": { "type": "string" },
        "partIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "mimeType": { "type": "string" },
        "fileName": { "type": "string" },
        "data": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["docId", "partIndex", "totalChunks", "data"]
    },
    "userPreference": {
      "title": "UserPreferences",
      "description": "Persistent user-specific workspace filters, selected tabs, and notification state across sessions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "officer", "trainee"] },
        "adminActiveTab": { "type": "string" },
        "officerActiveTab": { "type": "string" },
        "traineeActiveTab": { "type": "string" },
        "selectedTradeId": { "type": "string" },
        "selectedSessionId": { "type": "string" },
        "selectedRegister": { "type": "string" },
        "attendanceDate": { "type": "string" },
        "historyMonth": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "role", "updatedAt"]
    },
    "authSession": {
      "title": "AuthSessionRecord",
      "description": "Persistent server-verified login session restored across browser restarts",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "officer", "trainee"] },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["token", "userId", "role", "expiresAt"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Institutional configuration and system settings"
    },
    "/sessions/{sessionId}": {
      "schema": "session",
      "description": "Academic sessions collection"
    },
    "/trades/{tradeId}": {
      "schema": "trade",
      "description": "Vocational trades offered by the ITI"
    },
    "/officers/{officerId}": {
      "schema": "officer",
      "description": "Training officers and staff profiles"
    },
    "/trainees/{traineeId}": {
      "schema": "trainee",
      "description": "Enrolled trainees and student profiles"
    },
    "/attendance/{attendanceId}": {
      "schema": "attendance",
      "description": "Daily verified attendance records"
    },
    "/assessments/{assessmentId}": {
      "schema": "assessment",
      "description": "Monthly formative assessment marks and progress cards"
    },
    "/leaves/{leaveId}": {
      "schema": "leave",
      "description": "Trainee leave applications and sanctions"
    },
    "/warnings/{warningId}": {
      "schema": "warning",
      "description": "Regulatory attendance shortage notices"
    },
    "/workingDays/{workingDayId}": {
      "schema": "workingDay",
      "description": "Academic calendar monthly working days"
    },
    "/holidays/{holidayId}": {
      "schema": "holiday",
      "description": "Admin-designated session holidays restricting attendance"
    },
    "/documents/{docId}": {
      "schema": "document",
      "description": "Persistent document metadata linked to Firebase Storage or chunked Firestore payloads"
    },
    "/storedFiles/{fileId}": {
      "schema": "storedFile",
      "description": "Binary document chunks stored safely in Cloud Firestore"
    },
    "/userPreferences/{userId}": {
      "schema": "userPreference",
      "description": "User-specific persistent workspace preferences, active tabs, and filters"
    },
    "/authSessions/{token}": {
      "schema": "authSession",
      "description": "Persistent server-verified authentication sessions"
    }
  }
}
